{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Loans": "Data Source=fundo-loans.db"
  },
  "SsnHashing": {
    "Key": "local-development-key-not-a-secret"
  },
  "DecisionRules": {
    "RestrictedStates": [ "NY" ],
    "BlacklistedSsns": [ "111-11-1111", "222-22-2222", "333-33-3333" ]
  },
  "ExternalService": {
    "BaseUrl": "http://localhost:5081",
    "TimeoutSeconds": 10
  },
  "Outbox": {
    "PollingIntervalSeconds": 2,
    "BatchSize": 20,
    "MaxAttempts": 5,
    "BaseRetryDelaySeconds": 5
  }
}
